# ============================================
# CalendarOps 环境变量（今晚填好，明天直接跑）
# ============================================
# LLM（二选一，优先 NEON gateway —— demo 提它是加分项）
# Neon AI Gateway: https://neon.tech → AI Gateway → 拿 gateway URL + key
NEON_AI_GATEWAY_URL=https://ai-gateway.neon.tech/v1
NEON_AI_GATEWAY_API_KEY=ne_ai_xxx

# 备用：OpenRouter（已存在于 ~/.workbuddy/.secrets/openrouter.env）
OPENROUTER_API_KEY=

# 模型名（走 Neon gateway 时可用 openai/gpt-oss-120b 等；走 OpenRouter 用 openai/gpt-4o-mini）
LLM_MODEL=openai/gpt-4o-mini

# 数据库（Neon connection string；没填时自动降级本地 libsql 文件，demo 也能跑）
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# AgentMail（明天现场注册后填；今晚留空走模拟模式）
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Exa（今晚注册 dashboard.exa.ai）
EXA_API_KEY=
